# ForteBank Datathon 26 — настройки сервиса. Скопируйте в .env и заполните.

# API-ключ для жюри (обязателен; без него сервис отклоняет все запросы).
# Сгенерируйте:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Максимальный размер загружаемого файла, байт (по умолчанию 200 МБ; в кейсе видео ~29 МБ)
MAX_FILE_SIZE=209715200

# Каталоги (относительно корня проекта)
UPLOAD_DIR=uploads
EVIDENCE_DIR=evidence
MODEL_DIR=models
DB_PATH=fortebank_datathon.db

# Бюджет обработки одного видео от момента получения, сек (по кейсу лимит 300 с; 30 с — запас на выдачу ответа)
MAX_PROCESSING_TIME=270

# Ограничения входного видео
MAX_VIDEO_SECONDS=900

# Защита от перебора ключа: неудачных попыток за окно (сек)
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW_SEC=60

# Сервер: по умолчанию только localhost, наружу — через туннель (scripts/start_tunnel.sh)
HOST=127.0.0.1
PORT=8000
JOB_RETENTION_HOURS=48
